{
  "name": "@schroeder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.2.3",
    "@schroeder/bc-contract": "workspace:*",
    "@schroeder/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.1.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@schroeder/bc-mock": "workspace:*",
    "@swc/core": "^1.15.3",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.7",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.10"
  }
}
