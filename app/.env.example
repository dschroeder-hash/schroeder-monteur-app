# Auth: 'entra' (Microsoft Entra ID via MSAL) or 'dev' (local personas, never in prod)
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
# Scope of the API app registration, e.g. api://schroeder-monteur-api/access_as_user
NEXT_PUBLIC_ENTRA_API_SCOPE=
# Optional base path when mounted as a module inside the CRM, e.g. /werkstatt
NEXT_PUBLIC_BASE_PATH=
